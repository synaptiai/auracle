node_modules/
dist/
.DS_Store
/corpus/

# Secrets: OPENROUTER_API_KEY etc. Never commit.
.env

# Run artifacts on disk, never commit (same rule as triage/v1.json).
# The exception is the published artifact: README.md quotes its numbers, so
# it ships with the repository and is tracked.
# Exclude the directory's contents, not the directory: a negation cannot
# re-include a file inside an excluded directory.
/gold-report/*
!/gold-report/v5.json
/triage/

# Calibration artifacts are run output, not source. A committed artifact would
# be adopted by every checkout and would move each adopter's gates to numbers
# fitted on somebody else's corpus. Run `pnpm run calibrate` to make your own.
/calibration/
.creatumo/MEMORY.md

# Agent session transcripts. Never commit.
.trail/

# Python bytecode from the hook tests.
__pycache__/
*.pyc
