node_modules/
dist/
# pnpm writes its content-addressed store here when the store directory is
# not writable, which happens when the suite runs in a container over a bind
# mount. It is 120MB of regenerable cache and must never be committed.
.pnpm-store/
.DS_Store
/corpus/

# Secrets: OPENROUTER_API_KEY etc. Never commit.
.env

# Run artifacts on disk, never commit (same rule as triage/v1.json).
# The exception is the published artifact: README.md quotes its numbers, so
# it ships with the repository and is tracked. One version is tracked at a
# time, and it is the one README names; the negation moves with it.
# Exclude the directory's contents, not the directory: a negation cannot
# re-include a file inside an excluded directory.
/gold-report/*
!/gold-report/v9.json
/triage/

# A latency report describes the adopter's own traffic, and they are the data
# controller (DEC-17, DEC-19). Nothing in this repository quotes its numbers,
# so unlike the gold report there is no version to track.
/latency/

# Control-band daily samples. The adopter's own traffic, so it stays with the
# adopter (DEC-17, DEC-19) — like /latency/ and /triage/ above.
/bands/

# Calibration artifacts are run output, not source. A committed artifact would
# be adopted by every checkout and would move each adopter's gates to numbers
# fitted on somebody else's corpus. Run `pnpm run calibrate` to make your own.
/calibration/

# Groundedness fits are run output too, and a committed one would move every
# adopter's second gate to a number fitted on somebody else's corpus. The
# resume files are ignored for the same reason and one more: they hold a row
# per scored draft of whatever half was run (DEC-18).
#
# One exception, and it is deliberately not an artifact. `reference-v2.json`
# is a copy of this repository's own fit, tracked so a reader can check the
# published numbers against the file that produced them. It is named outside
# the `v<n>.json` shape the version scanner reads, so no loader can find it
# and no checkout adopts it. src/groundedness/reference.test.ts proves that.
/groundedness/*
!/groundedness/reference-v3.json

# Per-session state of the agent tooling, including one config that embeds a
# developer's absolute home directory. The design records that lived under
# `.creatumo/design/` are shipped documentation and moved to `docs/design/`,
# which `scripts/check-docs.py` resolves the register's section 7.1 against
# (issue #79).
.creatumo/

# Agent session transcripts. Never commit.
.trail/

# Python bytecode from the hook tests.
__pycache__/
*.pyc

# The decision journals the workflow commands write, one per issue, plus the
# lock files the recorder leaves beside them. Session state of the tooling,
# never a record of a decision: `docs/decisions/` holds those, and the
# register holds the decisions themselves (issue #79).
.decisions/

# Worktrees a subagent creates for parallel work. Harness state, never source.
/.claude/worktrees/

# What the review agents remember between sessions. It belongs to agents this
# repository does not define — `.claude/agents/` holds two, and neither of
# them (issue #79).
.claude/agent-memory/
.gstack/

# A vendored design handoff, 604K of JavaScript nobody in this repository
# wrote. PR #82 removed it from the branch and left it on disk, which left
# every `git status` reporting it and every workflow preflight blocked on it.
# docs/internal/ itself is tracked, so the rule names the one directory.
docs/internal/design_handoff_reviewer_console/

# The new text of an end-to-end artifact that differs from its golden.
# src/test-support/e2e-artifact.ts writes it; AURACLE_E2E_ACCEPT=1 clears it.
src/e2e/artifacts/**/*.actual.json
