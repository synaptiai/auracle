# Installed packages and build output.
node_modules/
dist/
# pnpm's package store, written here when its usual directory is not writable.
.pnpm-store/
# macOS folder metadata and the AppleDouble files it writes on other disks.
.DS_Store
._*
# Editor swap and lock files.
.*.sw?
.#*

# Secrets, such as OPENROUTER_API_KEY, in every form but the example.
.env*
!.env.example
*.env
# A contributor's own Claude Code settings.
.claude/settings.local.json

# Run output: an exported corpus and the offline jobs' results.
/corpus/
/gold-report/*
# The gold report the README quotes, tracked so its numbers can be checked.
!/gold-report/v9.json
/triage/
/latency/
/bands/
/calibration/
/groundedness/*
# This repository's own groundedness fit, tracked for the published numbers.
!/groundedness/reference-v3.json

# The new text of an end-to-end artifact that differs from its committed copy.
src/e2e/artifacts/**/*.actual.json

# Python bytecode from the checker and hook tests.
__pycache__/
*.pyc

# Local state of the workflow tools: journals, agent memory, worktrees.
.decisions/
.claude/agent-memory/
/.claude/worktrees/

# Agent session transcripts.
.trail/

# Local working notes.
docs/internal/
