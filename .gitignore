node_modules/
dist/
.DS_Store
/corpus/

# Secrets: OPENROUTER_API_KEY etc. Never commit.
.env

# Run artifacts on disk, never commit (same rule as triage/v1.json).
# The exception is the published artifact: README.md quotes its numbers, so
# it ships with the repository and is tracked. One version is tracked at a
# time, and it is the one README names; the negation moves with it.
# Exclude the directory's contents, not the directory: a negation cannot
# re-include a file inside an excluded directory.
/gold-report/*
!/gold-report/v7.json
/triage/

# A latency report describes the adopter's own traffic, and they are the data
# controller (DEC-17, DEC-19). Nothing in this repository quotes its numbers,
# so unlike the gold report there is no version to track.
/latency/

# Control-band daily samples. The adopter's own traffic, so it stays with the
# adopter (DEC-17, DEC-19) — like /latency/ and /triage/ above.
/bands/

# Calibration artifacts are run output, not source. A committed artifact would
# be adopted by every checkout and would move each adopter's gates to numbers
# fitted on somebody else's corpus. Run `pnpm run calibrate` to make your own.
/calibration/

# Groundedness fits are run output too, and a committed one would move every
# adopter's second gate to a number fitted on somebody else's corpus. The
# resume files are ignored for the same reason and one more: they hold a row
# per scored draft of whatever half was run (DEC-18).
#
# One exception, and it is deliberately not an artifact. `reference-v2.json`
# is a copy of this repository's own fit, tracked so a reader can check the
# published numbers against the file that produced them. It is named outside
# the `v<n>.json` shape the version scanner reads, so no loader can find it
# and no checkout adopts it. src/groundedness/reference.test.ts proves that.
/groundedness/*
!/groundedness/reference-v2.json
.creatumo/MEMORY.md

# Agent session transcripts. Never commit.
.trail/

# Python bytecode from the hook tests.
__pycache__/
*.pyc

# Lock files the decision-journal recorder leaves behind. They are
# process state, never a record of a decision.
.decisions/*.lock
