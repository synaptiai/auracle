{
  "name": "auracle",
  "version": "0.1.0",
  "private": true,
  "description": "Reference architecture for agentic customer support under two independent evidence gates, with a person approving every reply",
  "license": "Apache-2.0",
  "author": "Synapti",
  "homepage": "https://github.com/synaptiai/auracle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synaptiai/auracle.git"
  },
  "bugs": {
    "url": "https://github.com/synaptiai/auracle/issues"
  },
  "keywords": [
    "customer-support",
    "agents",
    "llm",
    "human-in-the-loop",
    "evidence-gates",
    "groundedness",
    "transactional-outbox",
    "postgresql",
    "pgvector",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.20.0",
  "exports": {
    ".": "./dist/index.js",
    "./ledger-read": "./dist/public/ledger-read.js",
    "./policy": "./dist/public/policy.js",
    "./domain": "./dist/public/domain.js",
    "./format": "./dist/public/format.js",
    "./cli": "./dist/public/cli.js"
  },
  "scripts": {
    "build": "node node_modules/typescript-7/bin/tsc -b tsconfig.build.json",
    "bootstrap": "bash scripts/bootstrap.sh",
    "check": "node node_modules/typescript-7/bin/tsc -b tsconfig.build.json && node node_modules/typescript-7/bin/tsc -p tsconfig.check.json && node node_modules/typescript-7/bin/tsc -p console/tsconfig.check.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:mail": "vitest run --project mail",
    "lint": "eslint .",
    "verify": "pnpm run build && pnpm run check && pnpm run lint && pnpm test && pnpm run verify:console && pnpm run check:docs && pnpm run check:ste && pnpm run check:guards && pnpm run check:fixtures",
    "verify:fast": "pnpm run check && pnpm run lint && pnpm run test:unit && pnpm run check:docs && pnpm run check:ste && pnpm run check:guards && pnpm run check:fixtures",
    "verify:console": "pnpm --filter @auracle/console build && pnpm --filter @auracle/console check && pnpm --filter @auracle/console test",
    "dev:webhook": "tsx src/intake/webhook-main.ts",
    "dev:imap": "tsx src/imap/main.ts",
    "dev:consumer": "tsx src/coordinator/consumer-main.ts",
    "dev:relay": "tsx src/relay/main.ts",
    "dev:console": "tsx --tsconfig console/tsconfig.dev.json console/src/main.ts",
    "check:docs": "python3 scripts/check-docs.py && python3 scripts/test_check_docs.py",
    "check:ste": "python3 scripts/ste-check.py && python3 scripts/test_ste_check.py",
    "check:guards": "python3 .claude/hooks/test_fixtures_pii_guard.py && python3 .claude/hooks/test_live_db_approval.py && python3 .claude/hooks/test_commit_dec_citation.py && python3 evals/run.py",
    "check:fixtures": "node scripts/generate-fixtures.mjs && git add -N fixtures/ && git diff --exit-code -- fixtures/ ':!fixtures/README.md'",
    "db:migrate": "pnpm run build && node dist/ledger/migrate.js",
    "latency": "pnpm run build && node dist/latency/run.js",
    "bands": "pnpm run build && node dist/bands/run.js",
    "escalations": "pnpm run build && node dist/escalations/cli.js",
    "reviewers": "pnpm run build && node dist/reviewers/cli.js",
    "approve": "pnpm run build && node dist/approval/cli.js",
    "calibrate": "pnpm run build && node dist/calibration/run.js",
    "replay": "pnpm run build && node dist/replay/cli.js",
    "gold-report": "pnpm run build && node dist/goldreport/run.js",
    "export-corpus": "pnpm run build && node dist/corpus/export-main.js",
    "induce": "pnpm run build && node dist/jobs/run-taxonomy-induction.js",
    "triage": "pnpm run build && node dist/triage/run.js",
    "relay": "pnpm run build && node dist/relay/main.js",
    "consumer": "pnpm run build && node dist/coordinator/consumer-main.js",
    "imap": "pnpm run build && node dist/imap/main.js",
    "webhook": "pnpm run build && node dist/intake/webhook-main.js",
    "load-docs": "pnpm run build && node dist/kb/cli.js",
    "fit-groundedness": "pnpm run build && node dist/groundedness/main.js",
    "report-groundedness": "pnpm run build && node dist/groundedness/report.js",
    "seed-history": "pnpm run build && node dist/seed/run.js",
    "verify:db": "pnpm run test:db && pnpm run test:mail",
    "check:watch": "node node_modules/typescript-7/bin/tsc -b tsconfig.build.json --watch",
    "test:watch": "vitest --project unit"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "imapflow": "^2.2.6",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1"
  }
}
