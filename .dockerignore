# Paths a COPY could still reach. The build copies what it needs by name.

# Host packages and build output: darwin binaries and a stale build.
node_modules
**/node_modules
dist
**/dist
# Git history and pnpm's package store.
.git
.pnpm-store

# Secrets, in every directory. The image reads its configuration at runtime.
**/.env*
!**/.env.example
**/*.env

# The gold corpus. No process in the image reads it.
fixtures/gold

# Run output: the adopter's own traffic (DEC-17, DEC-19).
corpus/
triage/
latency/
bands/
calibration/
groundedness/

# Local state of agent tools, and local working notes.
.claude/
.decisions/
.trail/
.flow/
.agents/
.codex/
.gstack/
docs/internal/
# Python caches and macOS folder metadata.
__pycache__/
**/__pycache__/
.pytest_cache/
.DS_Store
